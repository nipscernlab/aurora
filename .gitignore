# --- LaTeX build artefacts (docs/) ---
# The .tex sources AND the built main.pdf are tracked on purpose — the PDF is
# the reader-facing manual, shipped straight from the repo. Everything else
# pdflatex drops beside them is per-build scratch: regenerated on every compile,
# changes on every run, and pure noise in diffs. (*.log is already covered by
# the global rule at the top of this file.)
docs/**/*.aux
docs/**/*.out
docs/**/*.toc
docs/**/*.lof
docs/**/*.lot
docs/**/*.fls
docs/**/*.fdb_latexmk
docs/**/*.synctex.gz
docs/**/*.bbl
docs/**/*.blg
docs/**/*.idx
docs/**/*.ind
docs/**/*.ilg
docs/**/*.nav
docs/**/*.snm
docs/**/*.vrb
docs/**/*.bcf
docs/**/*.run.xml
docs/**/*.xdv

# --- Local env / secrets ---
.env
.env.*
!.env.example

# Gerado por scripts/gen-installer-license.js a cada build (beforePack)
build/license.txt

# Zips temporarios dos instaladores de componentes (components/Scripts/
# download-*.js baixam para a raiz e apagam ao extrair; um download em
# andamento nao pode entrar num commit).
aurora-msys-*.zip
aurora-*-nipscern*.zip
surfer-aurora*.zip

# Relatorio das corridas de teste. E diagnostico local, nao fonte: o
# arquivo existe para nenhuma falha se perder na rolagem do terminal.
reports/
