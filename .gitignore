# --- Node / Electron build artefacts ---
node_modules/
dist/
out/
release/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp.*
.yarn/

# --- Local user state ---
# .vscode: as configuracoes COMPARTILHADAS (tasks, launch, settings,
# extensions) sao versionadas de proposito - fazem parte do setup de dev.
# Qualquer outro arquivo local do editor continua fora.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.claude/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# --- Aurora runtime artefacts ---
components/Projeto/
components/Temp/
components/Backup/
*.spf.bak
*.aurora_backup

# --- Bundled toolchain binaries ---
# These ship via GitHub Releases (see RELEASE.md). They are NOT tracked
# in git history. The bootstrap step downloads them into components/Packages/
# on first launch. If you bring your own toolchain locally, drop it in the
# matching directory and it will Just Work.
components/Packages/
saphoComponents/Packages/

# Bibliotecas Python instaladas pelo painel, mais o manifesto e o cache do
# catalogo remoto. Tudo estado POR MAQUINA: o que se versiona e a LISTA
# (resources/pylib-catalog.json), nunca o que foi instalado nesta copia.
components/PyLibs/

# Manual do SAPHO. E gerado e publicado pelo repositorio nipscernlab/docs_aurora;
# download-docs.js traz o pacote da Release a cada bootstrap, como a toolchain.
# Versionar aqui duplicaria alguns megabytes de HTML, imagens e PDF, e a copia
# envelheceria em silencio a cada correcao de texto feita la.
resources/docs/

# Version manifest kept by scripts/verify-components.js — per-machine record of
# which toolchain tag is installed for each component, used to detect a version
# bump on `npm install` / `npm run components:verify`. Never commit it.
components/.aurora-versions.json

# YANC compilers (cmmcomp, asmcomp, appcomp, comp2gtkw) — built from
# the separate nipscernlab/yanc repo. download-yanc.js fetches them
# from that repo's GitHub Releases at prestart, same model as the main
# toolchain bundle above.
components/bin/

# SAPHO HDL library (core.v, ula.v, processor.v, instr_dec.v, ...), the C++
# shim Headers (cmath, vector, ...) and the float-math Macros (float_sin.asm,
# ...). All three ship INSIDE the yanc release (yanc-bin-vX.zip carries bin/ +
# HDL/ + Header/ + Macros/) so they stay version-matched with the compilers
# that emit code against them. download-yanc.js extracts them; do NOT commit a
# copy that can drift stale or show up as a spurious diff after every yanc bump
# (e.g. v5.1 swapped the LUT macros for minimax — committed copies would dirty
# every dev's working tree on the next `npm start`).
components/HDL/
components/Header/
components/Macros/

# --- Test scratch ---
coverage/
.nyc_output/

# --- TypeScript compiler output (.ts → .js in-place via tsc; run `npm run build:ts`) ---
# These are build artefacts — never edit the .js, edit the .ts source.
js/utils/path_utils.js
js/compilation/compilation_helpers.js
js/compilation/command_spec.js
js/compilation/command_overrides.js
js/compilation/spec_factory.js
js/compilation/spec_runner.js
js/compilation/verilator_tb.js
js/compilation/builders/asm.js
js/compilation/builders/cmm.js
js/compilation/builders/cocotb.js
js/compilation/builders/index.js
js/compilation/builders/iverilog.js
js/compilation/builders/verilator.js
js/compilation/builders/vvp.js
js/compilation/builders/wave_tools.js
js/compilation/builders/yosys.js
js/editor/document_type_detector.js
js/project/processor_list.js
js/project/spf_store.js
js/project/verilog_classifier.js
js/wave/complex_decode.js
js/wave/event_markers.js
js/wave/gtkw_proc_writer.js
js/wave/gtkw_writer.js
js/wave/selection_validator.js
js/wave/signal_parser.js
js/wave/surfer_layout_writer.js
js/wave/testbench_instrumenter.js
js/wave/vcd_parser.js
js/wave/wave_state_store.js

# --- LaTeX build artefacts (docs/) ---
# The .tex sources AND the built main.pdf are tracked on purpose — the PDF is
# the reader-facing manual, shipped straight from the repo. Everything else
# pdflatex drops beside them is per-build scratch: regenerated on every compile,
# changes on every run, and pure noise in diffs. (*.log is already covered by
# the global rule at the top of this file.)
docs/**/*.aux
docs/**/*.out
docs/**/*.toc
docs/**/*.lof
docs/**/*.lot
docs/**/*.fls
docs/**/*.fdb_latexmk
docs/**/*.synctex.gz
docs/**/*.bbl
docs/**/*.blg
docs/**/*.idx
docs/**/*.ind
docs/**/*.ilg
docs/**/*.nav
docs/**/*.snm
docs/**/*.vrb
docs/**/*.bcf
docs/**/*.run.xml
docs/**/*.xdv

# --- Local env / secrets ---
.env
.env.*
!.env.example

# Gerado por scripts/gen-installer-license.js a cada build (beforePack)
build/license.txt

# Zips temporarios dos instaladores de componentes (components/Scripts/
# download-*.js baixam para a raiz e apagam ao extrair; um download em
# andamento nao pode entrar num commit).
aurora-msys-*.zip
aurora-*-nipscern*.zip
surfer-aurora*.zip
