{
  "name": "sapho",
  "productName": "SAPHO",
  "description": "Scalable Architecture for Hardware Optimization",
  "author": "NIPSCERN",
  "version": "6.1.3",
  "win": {
    "icon": "./assets/icons/sapho_aurora_icon.ico"
  },
  "main": "main.js",
  "scripts": {
    "bootstrap": "node scripts/check-pinned-versions.js && node components/Scripts/download-toolchain.js && node components/Scripts/download-yanc.js && node components/Scripts/copy-components.js",
    "prestart": "npm run bootstrap",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.js",
    "rules:sync": "node scripts/sync-sapho-rules.js",
    "prebuild": "npm run bootstrap",
    "build": "electron-builder",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": "eslint --max-warnings=0"
  },
  "build": {
    "appId": "com.nipscern.auroraide",
    "productName": "Aurora-IDE",
    "fileAssociations": [
      {
        "ext": "spf",
        "name": "SAPHO Project File",
        "description": "SAPHO Project File",
        "role": "Editor",
        "icon": "./assets/icons/sapho_aurora_icon.ico"
      }
    ],
    "protocols": [
      {
        "name": "SAPHO Project Protocol",
        "schemes": [
          "sapho"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nipscernlab",
        "repo": "sapho",
        "releaseType": "release",
        "publishAutoUpdate": true
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./assets/icons/sapho_aurora_icon.ico",
      "artifactName": "sapho-aurora-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "files": [
      "**/*",
      "!components/**",
      "!tests/**",
      "!docs/**",
      "!scripts/**",
      "!build.bat",
      "!build.ps1",
      "!*.md",
      "!interlude.txt",
      "!.nvmrc",
      "!.release-please-manifest.json",
      "!release-please-config.json",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/min-maps/**",
      "!node_modules/@fortawesome/fontawesome-free/less/**",
      "!node_modules/@fortawesome/fontawesome-free/metadata/**",
      "!node_modules/@types/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-code/**",
      "node_modules/@anthropic-ai/claude-code-*/**",
      "node_modules/@openai/codex/**",
      "node_modules/@openai/codex-*/**"
    ],
    "extraResources": [
      {
        "from": "components",
        "to": "components_tmp",
        "filter": [
          "**/*",
          "!Projeto/**",
          "!Temp/**",
          "!Backup/**",
          "!**/*.bak",
          "!**/*.aurora_backup",
          "!**/*.spf.bak",
          "!**/*.log"
        ]
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "keywords": [
    "Aurora"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.64",
    "@anthropic-ai/claude-code": "^2.1.144",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "^0.131.0",
    "@silimate/netlistsvg": "github:nipscernlab/netlistsvg-aurora#58a0703904a35841616db58716f40532b84fb018",
    "ai": "^6.0.184",
    "chokidar": "^4.0.3",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.0",
    "monaco-editor": "0.52.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^25.6.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.9.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
