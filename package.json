{
  "name": "sapho",
  "productName": "SAPHO",
  "description": "Scalable Architecture for Hardware Optimization",
  "author": "NIPSCERN",
  "version": "6.3.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nipscernlab/aurora.git"
  },
  "bugs": {
    "url": "https://github.com/nipscernlab/aurora/issues"
  },
  "homepage": "https://github.com/nipscernlab/aurora#readme",
  "main": "main.js",
  "scripts": {
    "bootstrap": "node scripts/check-pinned-versions.js && node components/Scripts/download-toolchain.js && node components/Scripts/download-yanc.js && node components/Scripts/download-gtkwave-nipscern.js && node components/Scripts/download-norse-font.js && node components/Scripts/download-surfer.js && node components/Scripts/copy-components.js",
    "build:ts": "tsc",
    "build:renderer": "vite build",
    "predev": "npm run build:ts",
    "dev": "node scripts/dev.js",
    "prestart": "npm run bootstrap && npm run build:ts && npm run build:renderer",
    "start": "node scripts/launch-electron.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build:renderer",
    "test:e2e": "vitest run --config vitest.config.e2e.js",
    "deadcode": "knip --include files,dependencies --no-config-hints",
    "deadcode:all": "knip --no-config-hints",
    "rules:sync": "node scripts/sync-sapho-rules.js",
    "prebuild": "npm run bootstrap && npm run build:ts && npm run build:renderer",
    "build": "electron-builder",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "build": {
    "appId": "com.nipscern.auroraide",
    "productName": "Aurora-IDE",
    "fileAssociations": [
      {
        "ext": "spf",
        "name": "SAPHO Project File",
        "description": "SAPHO Project File",
        "role": "Editor",
        "icon": "./assets/icons/sapho_aurora_icon.ico"
      }
    ],
    "protocols": [
      {
        "name": "SAPHO Project Protocol",
        "schemes": [
          "sapho"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nipscernlab",
        "repo": "sapho",
        "releaseType": "release",
        "publishAutoUpdate": true
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./assets/icons/sapho_aurora_icon.ico",
      "artifactName": "sapho-aurora-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "files": [
      "**/*",
      "dist/**",
      "!components/**",
      "!tests/**",
      "!docs/**",
      "!scripts/**",
      "!*.md",
      "!.nvmrc",
      "!.release-please-manifest.json",
      "!release-please-config.json",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/min-maps/**",
      "!node_modules/@fortawesome/fontawesome-free/less/**",
      "!node_modules/@fortawesome/fontawesome-free/metadata/**",
      "!node_modules/@types/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-code/**",
      "node_modules/@anthropic-ai/claude-code-*/**",
      "node_modules/@openai/codex/**",
      "node_modules/@openai/codex-*/**"
    ],
    "extraResources": [
      {
        "from": "components",
        "to": "components_tmp",
        "filter": [
          "**/*",
          "!Projeto/**",
          "!Temp/**",
          "!Backup/**",
          "!**/*.bak",
          "!**/*.aurora_backup",
          "!**/*.spf.bak",
          "!**/*.log"
        ]
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "keywords": [
    "Aurora"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.64",
    "@anthropic-ai/claude-code": "^2.1.144",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "^0.131.0",
    "@phosphor-icons/web": "^2.1.1",
    "@silimate/netlistsvg": "github:nipscernlab/netlistsvg-aurora#58a0703904a35841616db58716f40532b84fb018",
    "ai": "^6.0.184",
    "chokidar": "^4.0.3",
    "diff2html": "^3.4.56",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.0",
    "katex": "^0.17.0",
    "lit": "^3.3.3",
    "monaco-editor": "0.52.2",
    "simple-git": "^3.36.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.34.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "knip": "6.17.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.5"
  }
}
