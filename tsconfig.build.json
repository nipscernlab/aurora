{
  // Emite o .js ao lado de cada .ts (a app carrega o .js). Os gerados estao
  // no .gitignore, e scripts/check-no-generated-js.js impede que entrem no
  // git. Roda via `npm run build:ts`. A VERIFICACAO de tipos e do
  // tsconfig.json, que este estende: la entram tambem os .js com
  // `// @ts-check`, e por isso o allowJs precisa voltar a false aqui, senao o
  // tsc tentaria gravar cada .js por cima dele mesmo.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": false,
    "rootDir": ".",
    "outDir": "."
  },
  // html/ entra junto porque as paginas secundarias (PRISM) tambem tem codigo
  // proprio, e ele emite o .js ao lado pelo mesmo caminho: o <script src> da
  // pagina continua apontando para o .js, que o Vite empacota e o Electron
  // carrega.
  "include": ["js/**/*.ts", "html/**/*.ts"]
}
