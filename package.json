{
  "name": "sapho",
  "productName": "SAPHO",
  "description": "Scalable Architecture for Hardware Optimization",
  "author": "NIPSCERN",
  "version": "4.1.13",
  "win": {
    "icon": "./assets/icons/sapho_aurora_icon.ico"
  },
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/check-pinned-versions.js && node components/Scripts/download-toolchain.js && node components/Scripts/download-yanc.js && node components/Scripts/copy-components.js",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.js",
    "build": "electron-builder",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": "eslint --max-warnings=0"
  },
  "build": {
    "appId": "com.nipscern.auroraide",
    "productName": "Aurora-IDE",
    "fileAssociations": [
      {
        "ext": "spf",
        "name": "SAPHO Project File",
        "description": "SAPHO Project File",
        "role": "Editor",
        "icon": "./assets/icons/sapho_aurora_icon.ico"
      }
    ],
    "protocols": [
      {
        "name": "SAPHO Project Protocol",
        "schemes": [
          "sapho"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nipscernlab",
        "repo": "Aurora",
        "releaseType": "release",
        "publishAutoUpdate": true
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./assets/icons/sapho_aurora_icon.ico",
      "artifactName": "AuroraIDE-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "components",
        "to": "components_tmp"
      },
      {
        "from": "components/Packages/PRISM/netlistsvg/netlistsvg.exe",
        "to": "bin/netlistsvg.exe"
      },
      {
        "from": "components/Packages/PRISM/yosys/yosys.exe",
        "to": "bin/yosys.exe"
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "keywords": [
    "Aurora"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "chokidar": "^4.0.3",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.0",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^25.6.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.9.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
