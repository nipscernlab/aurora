{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "removeComments": false,
    "rootDir": ".",
    "outDir": "."
  },
  "include": [
    "js/types/aurora-globals.d.ts",
    "js/utils/path_utils.ts",
    "js/compilation/compilation_helpers.ts",
    "js/wave/signal_parser.ts",
    "js/wave/selection_validator.ts",
    "js/wave/testbench_instrumenter.ts",
    "js/wave/vcd_parser.ts",
    "js/project/verilog_classifier.ts",
    "js/editor/document_type_detector.ts",
    "js/wave/gtkw_writer.ts",
    "js/wave/gtkw_proc_writer.ts",
    "js/project/processor_list.ts",
    "js/wave/wave_state_store.ts",
    "js/project/spf_store.ts",
    "js/compilation/command_spec.ts",
    "js/compilation/verilator_tb.ts",
    "js/compilation/builders/cmm.ts",
    "js/compilation/builders/asm.ts",
    "js/compilation/builders/cocotb.ts",
    "js/compilation/builders/iverilog.ts",
    "js/compilation/builders/vvp.ts",
    "js/compilation/builders/wave_tools.ts",
    "js/compilation/builders/yosys.ts",
    "js/compilation/builders/verilator.ts",
    "js/compilation/builders/index.ts",
    "js/compilation/command_overrides.ts",
    "js/compilation/spec_runner.ts",
    "js/compilation/spec_factory.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "components",
    "tests"
  ]
}
